# Atlas-RAG Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# LLM Inference Server
# ===========================================
# Option 1: Ollama (recommended for CPU, no GPU required)
VLLM_URL=http://localhost:11434/v1
VLLM_API_KEY=ollama
VLLM_MODEL=qwen2.5:7b
LLM_PROVIDER=ollama

# Option 2: vLLM (requires NVIDIA GPU)
# VLLM_URL=http://localhost:8000/v1
# VLLM_API_KEY=secret
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_PROVIDER=vllm

# Option 3: OpenAI API
# VLLM_URL=https://api.openai.com/v1
# VLLM_API_KEY=sk-your-api-key
# VLLM_MODEL=gpt-4o-mini
# LLM_PROVIDER=openai

# Fallback: Return context-only response if LLM unavailable
LLM_FALLBACK_ENABLED=true

# ===========================================
# PostgreSQL + pgvector
# ===========================================
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas_rag
VECTOR_TABLE=atlas_knowledge
POSTGRES_DB=atlas_rag
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas

# ===========================================
# Embedding Model
# ===========================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Reranker Model
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===========================================
# RAG Configuration
# ===========================================
# Note: BGE-M3 scores typically range 0.4-0.6
SIMILARITY_THRESHOLD=0.40
TOP_K_RESULTS=5
MAX_CONTEXT_LENGTH=8192

# Generation Settings
TEMPERATURE=0.0
MAX_TOKENS=1024

# ===========================================
# Security / Guardrails
# ===========================================
ENABLE_GUARDRAILS=true
# Retrieval score below which the output rail blocks as LOW_CONFIDENCE.
# Independent from SIMILARITY_THRESHOLD (which filters retrieval candidates).
MIN_CONFIDENCE_THRESHOLD=0.35
# Minimum fraction of response content-tokens that must appear in the
# retrieved context. Lower = more permissive, higher = stricter.
GROUNDEDNESS_THRESHOLD=0.50
# Block user inputs containing emails, phones, CIN, IBAN, or card numbers.
ENABLE_PII_DETECTION=true
# Semantic off-topic detection using embedding similarity to ACAPS anchors.
# Catches paraphrased off-topic queries that regex patterns miss.
ENABLE_SEMANTIC_SCOPE=true
SEMANTIC_SCOPE_THRESHOLD=0.35
LOG_LEVEL=INFO
DEBUG=false

